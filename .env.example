# Copy to .env and fill in. All keys are OPTIONAL for the free-core MVP.
# The free core (DefiLlama + CoinGecko free + GitHub + Santiment free) runs
# with only an (optional) GitHub token for higher rate limits.

# GitHub: 60 req/hr unauth -> 5000 req/hr with a token (recommended)
DYOR_GITHUB_TOKEN=

# CoinGecko Pro (optional — free demo tier works without this)
DYOR_COINGECKO_API_KEY=

# Santiment (optional). Anonymous access already covers daily_active_addresses
# + dev_activity (the address-growth & dev-trend signals). A key only adds the
# social_volume_total metric (social_trend), which is restricted anonymously.
DYOR_SANTIMENT_API_KEY=

# Alerting: Slack/Discord-compatible webhook for `dyor refresh` (optional)
DYOR_ALERT_WEBHOOK=

# --- Stage 2 paid add-ons (leave blank until needed) ---
DYOR_TOKENTERMINAL_API_KEY=
DYOR_COINGLASS_API_KEY=
DYOR_CRYPTORANK_API_KEY=
DYOR_GLASSNODE_API_KEY=
DYOR_NANSEN_API_KEY=
DYOR_MESSARI_API_KEY=
