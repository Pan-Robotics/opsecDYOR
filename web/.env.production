# Production config for the DYOR web app (dyor.cryptoopsec.com).
# Same-origin: nginx proxies /api/* and /openapi.json on this host to the FastAPI
# service, so the browser needs no CORS and no cross-origin calls.
# NOTE: a stray web/.env.local (with localhost) OVERRIDES this in a prod build —
# do NOT ship .env.local to the server (see DEPLOY.md).
NEXT_PUBLIC_API_URL=https://dyor.cryptoopsec.com
NEXT_PUBLIC_SITE_URL=https://www.cryptoopsec.com
NEXT_PUBLIC_MCP_URL=https://dyor.cryptoopsec.com/mcp
